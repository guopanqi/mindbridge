{
  "name": "mindbridge-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:sdk && npm run build:app",
    "check": "npm run build && node --test",
    "dev": "wrangler pages dev public",
    "predeploy": "npm run check",
    "deploy": "wrangler pages deploy public --project-name mindbridge-app --branch main",
    "db:migrate:care": "wrangler d1 migrations apply mindbridge-care --remote",
    "db:migrate:identity": "wrangler d1 migrations apply mindbridge-identity --remote",
    "build:sdk": "esbuild scripts/dingtalk-entry.js --bundle --format=iife --target=chrome90,safari14 --outfile=public/vendor/dingtalk-auth-v3.js",
    "build:app": "esbuild src/main.js --bundle --format=iife --target=es2020 --minify --outfile=public/app.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "dingtalk-jsapi": "3.2.9"
  }
}

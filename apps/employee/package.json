{
  "name": "mindbridge-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:sdk && npm run build:app",
    "check": "npm run build && node --test",
    "lab": "node scripts/harness-lab.mjs",
    "dev": "wrangler pages dev public",
    "predeploy": "npm run check",
    "deploy": "wrangler pages deploy public --project-name mindbridge-app --branch main",
    "db:migrate:care": "wrangler d1 migrations apply mindbridge-beta-care --remote",
    "db:migrate:identity": "wrangler d1 migrations apply mindbridge-identity --remote",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:app": "node scripts/build-app.mjs",
    "seed:generate": "node scripts/generate-seed.mjs",
    "seed:apply:local": "wrangler d1 execute mindbridge-care --local --file seed/demo_seed.sql",
    "seed:apply": "wrangler d1 execute mindbridge-care --remote --file seed/demo_seed.sql",
    "seed:reset:local": "wrangler d1 execute mindbridge-care --local --file scripts/reset-seed.sql",
    "seed:reset": "wrangler d1 execute mindbridge-care --remote --file scripts/reset-seed.sql"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "dingtalk-jsapi": "3.2.9"
  }
}

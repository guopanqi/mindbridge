# 本文件可以提交；复制为 .dev.vars 后填写真实值。不要把 .dev.vars 提交到 Git。
DINGTALK_APP_SECRET=""
# 单企业内部应用建议固定 CorpId；配置后服务端会拒绝伪造的 corpId。
DINGTALK_CORP_ID=""
ANON_HMAC_KEY_V1=""
SUBJECT_LOOKUP_KEY_V1=""
# 32 字节随机值的 base64url 编码
IDENTITY_ENCRYPTION_KEY_V1=""
# care D1 中业务原文的加密密钥：32 字节随机值的 base64url 编码
CARE_CONTENT_KEY_V1=""
# care 与 console 之间的内部服务令牌（两侧必须一致）
INTERNAL_SERVICE_TOKEN=""
# 内部研究原文导出专用令牌；与后台服务令牌分离，未配置则导出接口关闭。
RESEARCH_EXPORT_TOKEN=""
# 对话 Harness：Responses API（当前使用 DeepSeek）。MODEL_API_KEY 必须作为 secret 配置。
MODEL_API_KEY=""
MODEL_NAME="deepseek-v4-flash"
# Stream relay 专用令牌，与 INTERNAL_SERVICE_TOKEN 分离。未配置则机器人入口关闭。
BOT_RELAY_TOKEN=""
DINGTALK_ROBOT_CODE=""

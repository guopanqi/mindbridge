{
  "$schema": "../mindbridge-app/node_modules/wrangler/config-schema.json",
  "name": "mindbridge-janitor",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  // Cloudflare Pages 不支持 Cron 触发器，因此保留期清理由这个独立 Worker 定时驱动。
  // 它自己不碰数据库，只调用 care 的内部接口，保证清理规则只有一份实现。
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "CARE_API_ORIGIN": "https://mindbridge-app-8j6.pages.dev"
  },
  "observability": { "enabled": true }
}
